# Copy to .env.local and fill in. Every value here is public (it ships in the browser bundle).

# Supabase project that signs people in (CONTRACT-APP §1.2). The anon / publishable key, never the service key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Server's base, ending in /app/v1. Defaults to production when unset.
# Production: https://server-production-2202go.up.railway.app/app/v1 · dev stack: http://localhost:8080/app/v1
# The origin the app runs on must be in the Server's APP_ORIGINS, or the browser blocks every call (CORS).
NEXT_PUBLIC_GO_API_URL=
